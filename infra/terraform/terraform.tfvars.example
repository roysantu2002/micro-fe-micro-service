# ============================================================
# Copy this to terraform.tfvars before running terraform apply
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored — never commit it
# ============================================================

subscription_id     = "ac91a2b4-4d65-4c8d-9e4f-db410eef92a0"
location            = "eastus"
resource_group_name = "rg-yt-planner"
environment         = "dev"

# Tenant ID (from az account show)
# entra_tenant_id = "7e626a1e-dd27-4d19-a481-834ea79cd15b"

# MSAL App Registration Client ID — fill this in after completing Step 3
# entra_client_id = "PASTE_APP_REGISTRATION_CLIENT_ID_HERE"

# ── Set sensitive values as env vars instead of writing them here ─────────────
# export TF_VAR_entra_tenant_id="7e626a1e-dd27-4d19-a481-834ea79cd15b"
# export TF_VAR_entra_client_id="PASTE_APP_REGISTRATION_CLIENT_ID_HERE"
