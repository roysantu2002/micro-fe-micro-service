# ============================================================
# YouTube Content Planner — Environment Variables
# Copy this file: cp .env.example .env
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=youtube_planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_secret

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Azure infrastructure (Terraform / GitHub Actions) ───────
AZURE_SUBSCRIPTION_ID=ac91a2b4-4d65-4c8d-9e4f-db410eef92a0
AZURE_TENANT_ID=7e626a1e-dd27-4d19-a481-834ea79cd15b
AZURE_RESOURCE_GROUP=rg-yt-planner
AZURE_LOCATION=eastus

# ── Azure Entra ID / MSAL (frontend auth) ───────────────────
# App Registration client ID (for the user-facing SPA, not the CI/CD service principal)
PUBLIC_ENTRA_CLIENT_ID=d53a7e1b-47d9-477d-ba37-f9f0c9ea7be9
PUBLIC_ENTRA_TENANT_ID=7e626a1e-dd27-4d19-a481-834ea79cd15b

# ── Local dev auth mode (pick ONE combination) ──────────────
#
# Mode 1 — Skip auth entirely (fastest, no login screen):
#   PUBLIC_DEV_SKIP_AUTH=true
#   PUBLIC_MOCK_AUTH=false
#
# Mode 2 — In-app mock login (shows a fake login form, no Azure needed):
#   PUBLIC_DEV_SKIP_AUTH=false
#   PUBLIC_MOCK_AUTH=true
#
# Mode 3 — Real Azure AD login (requires http://localhost:3000 registered
#           as SPA redirect URI in the App Registration):
#   PUBLIC_DEV_SKIP_AUTH=false
#   PUBLIC_MOCK_AUTH=false
#
PUBLIC_DEV_SKIP_AUTH=true
PUBLIC_MOCK_AUTH=false
