FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG PUBLIC_ITEMS_MFE_REMOTE=/mfe/items/mf-manifest.json
ARG PUBLIC_ENTRA_CLIENT_ID
ARG PUBLIC_ENTRA_TENANT_ID
ARG PUBLIC_MOCK_AUTH=false

ENV PUBLIC_ITEMS_MFE_REMOTE=$PUBLIC_ITEMS_MFE_REMOTE
ENV PUBLIC_ENTRA_CLIENT_ID=$PUBLIC_ENTRA_CLIENT_ID
ENV PUBLIC_ENTRA_TENANT_ID=$PUBLIC_ENTRA_TENANT_ID
ENV PUBLIC_MOCK_AUTH=$PUBLIC_MOCK_AUTH
ENV NODE_ENV=production

RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
